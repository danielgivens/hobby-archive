---
import Base from '../layouts/Base.astro';
import { getSauces } from '../lib/sauces';

const sauces = await getSauces();
const shelfData = sauces.map((s) => s.shelf);
---
<Base title="Hobby Hot Sauce — Label Archive">
  <!-- Tall scroll track; the shelf sticks inside it and the scroll position loops. -->
  <div class="shelf-track" data-shelf-track>
    <section class="shelf" data-shelf aria-label="Sauce shelf">
      <canvas class="shelf-canvas" data-shelf-canvas aria-hidden="true"></canvas>

      <ol class="captions">
        {shelfData.map((shelf, i) => (
          <li class="caption" data-caption={i} aria-current={i === 0 ? 'true' : undefined}>
            <h2>{shelf.name}</h2>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <script type="application/json" id="sauce-data" set:html={JSON.stringify(shelfData)} />
  <script>
    import { initShelf } from '../scripts/shelf';
    initShelf();
  </script>
</Base>
